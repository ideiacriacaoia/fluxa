# ==============================================================================
# FLUXA TÊXTIL (ERP) — Variáveis de Ambiente
# ==============================================================================
# Copie este arquivo para .env.local em desenvolvimento ou configure no painel da Vercel / Railway em produção.
# NUNCA insira chaves reais neste arquivo de exemplo.

# --- SUPABASE (PostgreSQL & Autenticação) ---
# URL pública do projeto Supabase (Configurações do Projeto -> API)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave anônima pública para consultas com RLS ativo no frontend
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Chave de Serviço (Apenas para rotas de backend/Server Actions administrativas - NUNCA expor com NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- APLICAÇÃO ---
# URL base do sistema (utilizada para redirecionamentos e callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

